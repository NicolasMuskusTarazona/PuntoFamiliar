generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  image    String
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  base_price  Float
  description String?
  image       String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
}

model Extra {
  id    Int    @id @default(autoincrement())
  name  String
  price Float
}